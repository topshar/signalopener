# Which provider to use: "gemini" (default) or "openrouter".
# There is no automatic fallback between providers.
AI_PROVIDER=gemini

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier model. Flash-Lite measured 4-6s per call vs timeouts on Flash (Nov 2026).
# Check current IDs and limits in AI Studio before changing.
GEMINI_MODEL=gemini-3.5-flash-lite
# How much the model "thinks" before answering: minimal | low | medium | high.
# Stage 1 measured 2,201 thinking tokens for a 196-token answer, so default is low.
# Set to empty to send no thinking setting at all.
GEMINI_THINKING_LEVEL=low

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Pick a current ":free" model from https://openrouter.ai/models?q=free
# Free model availability changes often; verify the ID before using it.
OPENROUTER_MODEL=

# Max model runs per day for the whole app (protects the free-tier quota).
DAILY_RUN_LIMIT=200
