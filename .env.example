# Which provider to use: "gemini" (default) or "openrouter".
# There is no automatic fallback between providers.
AI_PROVIDER=gemini

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier model. Check current IDs and limits in AI Studio before changing.
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Pick a current ":free" model from https://openrouter.ai/models?q=free
# Free model availability changes often; verify the ID before using it.
OPENROUTER_MODEL=
